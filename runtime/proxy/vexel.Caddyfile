# Vexel Health Platform — Caddy virtual host rules
# Source of truth for the intended vexel.alshifalab.pk routing.
#
# IMPORTANT (as of 2026-08-27, see docs/ops/INCIDENTS.md): the live
# /etc/caddy/Caddyfile on the shared host does NOT use an
# `import overrides/*.Caddyfile` mechanism — that directory does not exist.
# This block must be kept in sync MANUALLY as an inline block appended
# directly to /etc/caddy/Caddyfile, the same way every other product on
# that shared host is configured. A prior edit to the shared file (for an
# unrelated product) silently dropped Vexel's block entirely with no
# fallback, causing a real production outage — see the incident log for
# the full story and the recommended follow-up (formalizing a real
# overrides-import convention so this can't happen silently again).
#
# Ports (all bind to 127.0.0.1):
#   9021 = API (NestJS, prefix /api/*)
#   9022 = PDF service (strip /pdf prefix)
#   9023 = Admin app (Next.js basePath: /admin)
#   9024 = Operator app (catch-all)
#   9027 = MinIO storage (presigned URL bucket access)
#
# To add a new subdomain for a new tenant:
#   1. Add a new host block below following the same pattern.
#   2. Manually mirror this file's content into the live
#      /etc/caddy/Caddyfile (append, do not use `import` — see above).
#   3. Validate first: caddy adapt --config /etc/caddy/Caddyfile
#   4. Get explicit human confirmation, then:
#      sudo caddy reload --config /etc/caddy/Caddyfile

# VEXEL MONOREPO
vexel.alshifalab.pk {
	encode zstd gzip
	import std_headers
	import std_log vexel

	# API — preserve /api prefix (NestJS setGlobalPrefix('api'))
	handle /api/* {
		reverse_proxy 127.0.0.1:9021 {
			import std_proxy
		}
	}

	# PDF service — strip /pdf prefix
	handle_path /pdf/* {
		reverse_proxy 127.0.0.1:9022 {
			import std_proxy
		}
	}

	# Admin app — preserve /admin prefix (Next.js basePath: '/admin')
	# Must match both /admin (bare) and /admin/* (all sub-paths)
	handle /admin {
		reverse_proxy 127.0.0.1:9023 {
			import std_proxy
		}
	}
	handle /admin/* {
		reverse_proxy 127.0.0.1:9023 {
			import std_proxy
		}
	}

	# MinIO storage — bucket direct access for presigned URLs
	handle /vexel-documents/* {
		reverse_proxy 127.0.0.1:9027 {
			import std_proxy
		}
	}

	# Operator app — everything else
	handle {
		reverse_proxy 127.0.0.1:9024 {
			import std_proxy
		}
	}
}
